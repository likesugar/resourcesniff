<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/toolRoot"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <TextView android:id="@+id/lanToggle"
        android:layout_width="44dp" android:layout_height="44dp"
        android:layout_gravity="top|right" android:layout_marginTop="14dp" android:layout_marginRight="64dp"
        android:gravity="center" android:elevation="6dp"
        android:text="🗄️" android:textSize="18sp"/>

    <TextView android:id="@+id/themeToggle"
        android:layout_width="44dp" android:layout_height="44dp"
        android:layout_gravity="top|right" android:layout_margin="14dp"
        android:gravity="center" android:elevation="6dp"
        android:text="🌙" android:textSize="20sp"/>

    <LinearLayout android:id="@+id/toolColumn"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/bg">

        <ScrollView
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:fillViewport="true" android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="18dp" android:paddingRight="18dp"
                android:paddingTop="14dp" android:paddingBottom="18dp">

                <LinearLayout android:tag="card" android:id="@+id/cardPlayer"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:background="@drawable/bg_card" android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView
                            android:layout_width="46dp" android:layout_height="46dp"
                            android:background="@drawable/bg_btn"
                            android:text="🪩" android:textSize="22sp" android:gravity="center"/>
                        <TextView
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:layout_marginLeft="12dp"
                            android:text="资源嗅探" android:textSize="17sp"
                            android:textStyle="bold" android:tag="title" android:textColor="@color/textMain"/>
                        <TextView android:text="›" android:textSize="20sp"
                            android:textColor="#C3CAD6"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:tag="card" android:id="@+id/cardDownload"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_card" android:orientation="vertical"
                    android:padding="20dp">
                    <LinearLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView
                            android:layout_width="46dp" android:layout_height="46dp"
                            android:background="@drawable/bg_btn"
                            android:text="➼" android:textSize="22sp" android:gravity="center"/>
                        <TextView
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:layout_marginLeft="12dp"
                            android:text="资源下载" android:textSize="17sp"
                            android:textStyle="bold" android:tag="title" android:textColor="@color/textMain"/>
                        <TextView android:text="›" android:textSize="20sp"
                            android:textColor="#C3CAD6"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>
                 <LinearLayout android:tag="card" android:id="@+id/cardVideoDl"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_card" android:orientation="vertical"
                    android:padding="18dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="46dp" android:layout_height="46dp"
                            android:background="@drawable/bg_btn"
                            android:text="🎬" android:textSize="22sp" android:gravity="center"/>
                        <TextView
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:layout_marginLeft="12dp"
                            android:text="视频下载" android:textSize="17sp"
                            android:textStyle="bold" android:tag="title" android:textColor="@color/textMain"/>
                        <TextView android:text="›" android:textSize="20sp"
                            android:textColor="#C3CAD6"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginLeft="12dp" android:layout_marginTop="4dp"
                        android:text="yt-dlp 解析 · 粘贴链接极速下载" android:textSize="13sp"
                        android:tag="sub" android:textColor="@color/textSub"/>
                </LinearLayout>

               <LinearLayout android:tag="card" android:id="@+id/cardShortcut"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_card" android:orientation="vertical"
                    android:padding="20dp">
                    <LinearLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView
                            android:layout_width="46dp" android:layout_height="46dp"
                            android:background="@drawable/bg_btn" android:padding="8dp"
                            android:text="⚡" android:textSize="22sp" android:gravity="center"/>
                        <TextView
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:layout_marginLeft="12dp"
                            android:text="创建快捷键" android:textSize="17sp"
                            android:textStyle="bold" android:tag="title" android:textColor="@color/textMain"/>
                        <TextView android:text="›" android:textSize="20sp"
                            android:textColor="#C3CAD6"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>



                <LinearLayout android:tag="card" android:id="@+id/cardAppSettings"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_card" android:orientation="vertical"
                    android:padding="20dp">
                    <LinearLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView
                            android:layout_width="46dp" android:layout_height="46dp"
                            android:background="@drawable/bg_btn" android:padding="8dp"
                            android:text="⚙️" android:textSize="22sp" android:gravity="center"/>
                        <TextView
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:layout_marginLeft="12dp"
                            android:text="设置" android:textSize="17sp"
                            android:textStyle="bold" android:tag="title" android:textColor="@color/textMain"/>
                        <TextView android:text="›" android:textSize="20sp"
                            android:textColor="#C3CAD6"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
