<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/toolRoot"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <TextView android:id="@+id/lanToggle"
        android:layout_width="44dp" android:layout_height="44dp"
        android:layout_gravity="top|right" android:layout_marginTop="14dp" android:layout_marginRight="64dp"
        android:gravity="center" android:elevation="6dp"
        android:text="🗄️" android:textSize="18sp"/>

    <TextView android:id="@+id/themeToggle"
        android:layout_width="44dp" android:layout_height="44dp"
        android:layout_gravity="top|right" android:layout_margin="14dp"
        android:gravity="center" android:elevation="6dp"
        android:text="🌙" android:textSize="20sp"/>

    <LinearLayout android:id="@+id/toolColumn"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:fillViewport="true" android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="18dp" android:paddingRight="18dp"
                android:paddingTop="70dp" android:paddingBottom="150dp">

                <LinearLayout android:tag="card" android:id="@+id/cardPlayer"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_md3" android:orientation="vertical"
                    android:padding="20dp">
                    <LinearLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView
                            android:layout_width="48dp" android:layout_height="48dp"
                            android:background="@drawable/bg_btn_md3"
                            android:text="🪩" android:textSize="22sp" android:gravity="center"/>
                        <TextView
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:layout_marginLeft="12dp"
                            android:text="资源嗅探" android:textSize="17sp"
                            android:textStyle="bold" android:tag="title" android:textColor="@color/textMain"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:tag="card" android:id="@+id/cardDownload"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_card_md3" android:orientation="vertical"
                    android:padding="20dp">
                    <LinearLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView
                            android:layout_width="48dp" android:layout_height="48dp"
                            android:background="@drawable/bg_btn_md3"
                            android:text="➼" android:textSize="22sp" android:gravity="center"/>
                        <TextView
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:layout_marginLeft="12dp"
                            android:text="资源下载" android:textSize="17sp"
                            android:textStyle="bold" android:tag="title" android:textColor="@color/textMain"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:tag="card" android:id="@+id/cardVideoDl"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_card_md3" android:orientation="vertical"
                    android:padding="20dp">
                    <LinearLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView
                            android:layout_width="48dp" android:layout_height="48dp"
                            android:background="@drawable/bg_btn_md3"
                            android:text="🎬" android:textSize="22sp" android:gravity="center"/>
                        <TextView
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:layout_marginLeft="12dp"
                            android:text="视频下载" android:textSize="17sp"
                            android:textStyle="bold" android:tag="title" android:textColor="@color/textMain"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:tag="card" android:id="@+id/calendarCard"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_card_md3" android:orientation="vertical"
                    android:padding="20dp">
                    <LinearLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView
                            android:layout_width="48dp" android:layout_height="48dp"
                            android:background="@drawable/bg_btn_md3"
                            android:text="📅" android:textSize="22sp" android:gravity="center"/>
                        <TextView
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:layout_marginLeft="12dp"
                            android:text="日历" android:textSize="17sp"
                            android:textStyle="bold" android:tag="title" android:textColor="@color/textMain"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:tag="card" android:id="@+id/cardMed"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_card_md3" android:orientation="vertical"
                    android:padding="20dp">
                    <LinearLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView
                            android:layout_width="48dp" android:layout_height="48dp"
                            android:background="@drawable/bg_btn_md3"
                            android:text="💊" android:textSize="22sp" android:gravity="center"/>
                        <TextView
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:layout_marginLeft="12dp"
                            android:text="用药提醒" android:textSize="17sp"
                            android:textStyle="bold" android:tag="title" android:textColor="@color/textMain"/>
                    </LinearLayout>
                    <TextView
                        android:id="@+id/medStatus"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="10dp" android:tag="sub"
                        android:text="🌱 还没有计划，点进去添加" android:textSize="13sp"
                        android:textColor="#8A94A6"/>
                </LinearLayout>

                <LinearLayout android:tag="card" android:id="@+id/cardShortcut"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_card_md3" android:orientation="vertical"
                    android:padding="20dp">
                    <LinearLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView
                            android:layout_width="48dp" android:layout_height="48dp"
                            android:background="@drawable/bg_btn_md3"
                            android:text="⚡" android:textSize="22sp" android:gravity="center"/>
                        <TextView
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:layout_marginLeft="12dp"
                            android:text="创建快捷键" android:textSize="17sp"
                            android:textStyle="bold" android:tag="title" android:textColor="@color/textMain"/>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
