<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:padding="20dp">
        <TextView android:id="@+id/btnBack"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="‹" android:textSize="26sp" android:paddingRight="18dp"/>
        <TextView android:id="@+id/tvTitle"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="设置" android:textSize="22sp" android:textStyle="bold"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent" android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingLeft="20dp" android:paddingRight="20dp" android:paddingBottom="40dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="平台账号" android:textSize="15sp" android:id="@+id/label1"
                android:paddingTop="8dp" android:paddingBottom="14dp"/>

            <LinearLayout android:id="@+id/card1"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_md3"
                android:padding="20dp">

                <ScrollView android:id="@+id/platScroll"
                    android:layout_width="match_parent" android:layout_height="240dp"
                    android:scrollbars="none" android:overScrollMode="never">
                <ScrollView android:id="@+id/platScroll"
                    android:layout_width="match_parent" android:layout_height="240dp"
                    android:scrollbars="none" android:overScrollMode="never">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <!-- 哔哩哔哩 -->
                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="哔哩哔哩" android:textSize="18sp" android:textStyle="bold" android:id="@+id/t1"/>
                        <TextView android:id="@+id/biliState"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="未登录" android:textSize="14sp" android:paddingTop="4dp"/>
                    </LinearLayout>
                    <TextView android:id="@+id/biliAction"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="网页登录" android:textSize="16sp" android:padding="8dp"/>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginTop="16dp" android:layout_marginBottom="16dp" android:id="@+id/div1"/>

                <!-- 抖音 -->
                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="抖音" android:textSize="18sp" android:textStyle="bold" android:id="@+id/t2"/>
                        <TextView android:id="@+id/dyState"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="未登录" android:textSize="14sp" android:paddingTop="4dp"/>
                    </LinearLayout>
                    <TextView android:id="@+id/dyAction"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="网页登录" android:textSize="16sp" android:padding="8dp"/>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginTop="16dp" android:layout_marginBottom="16dp" android:id="@+id/div2"/>

                <!-- YouTube -->
                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="YouTube" android:textSize="18sp" android:textStyle="bold" android:id="@+id/t3"/>
                        <TextView android:id="@+id/ytState"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="未登录" android:textSize="14sp" android:paddingTop="4dp"/>
                    </LinearLayout>
                    <TextView android:id="@+id/ytAction"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="网页登录" android:textSize="16sp" android:padding="8dp"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/divider" android:layout_marginTop="16dp" android:layout_marginBottom="16dp" android:id="@+id/divCust"/>
                    </LinearLayout>
                </ScrollView>

                </ScrollView>

                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="＋ 自定义平台" android:textSize="18sp" android:textStyle="bold" android:id="@+id/tCust"/>
                        <TextView android:id="@+id/custState"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="未配置" android:textSize="14sp" android:paddingTop="4dp"/>
                    </LinearLayout>
                    <TextView android:id="@+id/custAction"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="配置" android:textSize="16sp" android:padding="8dp"/>
                </LinearLayout>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="登录后使用账号可访问的画质与资源。会员、地区和平台验证限制仍以网站为准。"
                    android:textSize="14sp" android:id="@+id/desc1"
                    android:paddingTop="18dp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="登录信息只保存在本机，用于对应平台的请求。不会读取或保存密码，登录过期后请重新登录。"
                    android:textSize="14sp" android:id="@+id/desc2"
                    android:paddingTop="10dp"/>

                <TextView android:id="@+id/btnClearAll"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="清除全部网页登录" android:textSize="16sp" android:paddingTop="22dp"/>
            </LinearLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="链接与提醒" android:textSize="15sp" android:id="@+id/label2"
                android:paddingTop="26dp" android:paddingBottom="14dp"/>

            <LinearLayout android:id="@+id/card2"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_md3"
                android:padding="20dp">
                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="自动检测剪贴板" android:textSize="18sp" android:textStyle="bold" android:id="@+id/t4"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="打开应用或回到前台时，识别视频并提示下载。"
                            android:textSize="14sp" android:id="@+id/desc3" android:paddingTop="6dp"/>
                    </LinearLayout>
                    <Switch android:id="@+id/swClipboard"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginTop="16dp" android:layout_marginBottom="16dp" android:id="@+id/div3"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="仅识别 B 站、抖音和 YouTube 视频，每次重新复制都会提醒，同一次复制不重复提醒。普通文本与敏感内容不会保存。"
                    android:textSize="14sp" android:id="@+id/desc4"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/card3"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_md3"
                android:padding="20dp"
                android:layout_marginTop="18dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="在其他应用中添加下载" android:textSize="18sp" android:textStyle="bold" android:id="@+id/t5"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="系统不允许后台读取剪贴板。在视频应用中选择「分享 → 更多 → 资源嗅探」，确认后即可下载。"
                    android:textSize="14sp" android:id="@+id/desc5" android:paddingTop="6dp"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/cardNotify"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:background="@drawable/bg_card_md3"
                android:padding="20dp"
                android:layout_marginTop="18dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="下载通知" android:textSize="18sp" android:textStyle="bold" android:id="@+id/t6"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="管理进度与完成提醒" android:textSize="14sp" android:id="@+id/desc6" android:paddingTop="6dp"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="→" android:textSize="20sp" android:id="@+id/arrow"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/cardAbout2"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_md3"
                android:padding="20dp"
                android:layout_marginTop="18dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="关于" android:textSize="18sp" android:textStyle="bold" android:id="@+id/tvAboutTitle2"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="查看每个卡片的用途说明"
                    android:textSize="14sp" android:id="@+id/tvAboutText2" android:paddingTop="8dp"/>
            </LinearLayout>

            
        </LinearLayout>
    </ScrollView>
</LinearLayout>
