<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pomoRoot"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FDF2F7">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingLeft="18dp" android:paddingRight="18dp"
        android:paddingTop="30dp" android:paddingBottom="8dp">
        <TextView android:id="@+id/pomoBack"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="‹" android:textSize="24sp" android:textStyle="bold"
            android:textColor="#D15B8E" android:paddingRight="14dp"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="🍅 番茄钟" android:textSize="22sp"
            android:textStyle="bold" android:textColor="#3D2B33"/>
        <TextView android:id="@+id/pomoGear"
            android:layout_width="40dp" android:layout_height="40dp" android:gravity="center"
            android:background="@drawable/bg_pomo_chip" android:text="⚙️" android:textSize="16sp"/>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true"
        android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="18dp"
            android:gravity="center_horizontal">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/bg_card_md3"
                android:padding="24dp" android:gravity="center_horizontal">
                <TextView android:id="@+id/pomoState"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:background="@drawable/bg_pomo_chip" android:paddingLeft="16dp" android:paddingRight="16dp"
                    android:paddingTop="6dp" android:paddingBottom="6dp"
                    android:text="😊 准备开始" android:textSize="14sp" android:textStyle="bold"
                    android:textColor="#C2497A"/>
                <com.wink.xgjhome.PomoRing
                    android:id="@+id/pomoRing"
                    android:layout_width="240dp" android:layout_height="240dp"
                    android:layout_marginTop="18dp"/>
                <TextView android:id="@+id/pomoSub"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="今天也要加油鸭 🌸" android:textSize="13sp" android:textColor="#B08497"/>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="18dp">
                    <TextView android:id="@+id/pomoStart"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:background="@drawable/bg_pomo_btn" android:paddingLeft="34dp" android:paddingRight="34dp"
                        android:paddingTop="12dp" android:paddingBottom="12dp"
                        android:text="▶ 开始专注" android:textSize="15sp" android:textStyle="bold"
                        android:textColor="#FFFFFF"/>
                    <TextView android:id="@+id/pomoReset"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginLeft="12dp"
                        android:background="@drawable/bg_pomo_chip" android:paddingLeft="22dp" android:paddingRight="22dp"
                        android:paddingTop="12dp" android:paddingBottom="12dp"
                        android:text="↺ 重置" android:textSize="15sp" android:textStyle="bold"
                        android:textColor="#C2497A"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/bg_card_md3"
                android:layout_marginTop="14dp" android:padding="20dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🥕 今日记录" android:textSize="15sp" android:textStyle="bold" android:textColor="#3D2B33"/>
                <TextView android:id="@+id/pomoStats"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="完成专注 0 次 · 暂停 0 次" android:textSize="13sp" android:textColor="#B08497"/>
                <LinearLayout android:id="@+id/pomoLog"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:layout_marginTop="6dp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
